  "get_discussion": {
   "action": "github.read.get_discussion",
   "risk": "low"
  },
  "get_discussion_comments": {
   "action": "github.read.get_discussion_comments",
   "risk": "low"
  },
  "get_file_contents": {
   "action": "github.read.get_file_contents",
   "risk": "low"
