 "hide": [],
 "suggested_rules": [
  "github.read.*=allow",
  "github.notification.*=allow",
  "github.star=allow",
  "github.issue.*=window:30m",
  "github.pr.review=each",
  "github.pr.merge=each",
  "github.file.*=each",
  "github.repo.*=each",
  "github.actions.*=each",
  "github.security.*=each",
  "github.pr.create=each",
  "github.pr.update=each",
  "github.pr.update_branch=each",
  "github.branch.create=window:30m",
  "github.label.write=window:30m",
  "github.project.write=window:30m",
  "github.discussion.comment=window:30m",
  "github.gist.write=each",
  "github.copilot.assign=each",
  "github.unmapped.*=each",
  "github.*=each"
 ]
}
