{
 "format": "sw-proxy/1",
 "name": "github",
 "title": "GitHub",
 "description": "GitHub's official MCP server (github-mcp-server 2.x), with every write approved through aiSecurityWarden. Keep a fine-grained personal access token, limited to the repositories the agent needs, as the project secret GITHUB_PAT.",
 "secrets": [
  "GITHUB_PAT"
 ],
 "upstream": {
  "stdio": {
   "command": "github-mcp-server",
   "args": [
    "stdio"
   ],
   "env": {
    "GITHUB_PERSONAL_ACCESS_TOKEN": "${secret:GITHUB_PAT}"
   }
  },
  "http": {
   "url": "https://api.githubcopilot.com/mcp/",
   "headers": {
    "Authorization": "Bearer ${secret:GITHUB_PAT}"
   }
  }
 },
 "tools": {
  "actions_get": {
   "action": "github.read.actions_get",
   "risk": "low"
  },
  "actions_list": {
   "action": "github.read.actions_list",
   "risk": "low"
  },
  "actions_run_trigger": {
   "action": "github.actions.run",
   "risk": "high",
   "scope": {
    "owner": "{owner}",
    "repo": "{owner}/{repo}"
   },
   "summary": {
    "title": "{method} a workflow run in {owner}/{repo}",
    "fields": []
   }
  },
  "add_comment_to_pending_review": {
   "action": "github.pr.review",
   "risk": "medium",
   "scope": {
    "owner": "{owner}",
    "repo": "{owner}/{repo}"
   },
   "summary": {
    "title": "Add a review comment in {owner}/{repo}",
    "fields": [
     [
      "Pull request",
      "#{pullNumber}"
     ],
     [
      "File",
      "{path}"
     ]
    ],
    "preview": "{body}"
   }
  },
  "add_issue_comment": {
   "action": "github.issue.comment",
   "risk": "medium",
   "scope": {
    "owner": "{owner}",
    "repo": "{owner}/{repo}"
   },
   "summary": {
    "title": "Comment on #{issue_number} in {owner}/{repo}",
    "fields": [],
    "preview": "{body}"
   }
  },
  "add_reply_to_pull_request_comment": {
   "action": "github.pr.review",
   "risk": "medium",
   "scope": {
    "owner": "{owner}",
    "repo": "{owner}/{repo}"
   },
   "summary": {
    "title": "Reply on pull request #{pullNumber} in {owner}/{repo}",
    "fields": [],
    "preview": "{body}"
   }
  },
  "assign_copilot_to_issue": {
   "action": "github.copilot.assign",
   "risk": "medium",
   "scope": {
    "owner": "{owner}",
    "repo": "{owner}/{repo}"
   },
   "summary": {
    "title": "Assign Copilot to #{issue_number} in {owner}/{repo}",
    "fields": []
   }
  },
  "assign_copilot_to_issue_with_intent": {
   "action": "github.copilot.assign",
   "risk": "medium",
   "scope": {
    "owner": "{owner}",
    "repo": "{owner}/{repo}"
   },
   "summary": {
    "title": "Assign Copilot to #{issue_number} in {owner}/{repo}",
    "fields": []
   }
  },
  "create_branch": {
   "action": "github.branch.create",
   "risk": "medium",
   "scope": {
    "owner": "{owner}",
    "repo": "{owner}/{repo}",
    "branch": "{owner}/{repo}/{branch}"
   },
   "summary": {
    "title": "Create branch {branch} in {owner}/{repo}",
    "fields": [
     [
      "From",
      "{from_branch}"
     ]
    ]
   }
  },
  "create_gist": {
   "action": "github.gist.write",
   "risk": "medium",
   "summary": {
    "title": "Create a gist",
    "fields": [
     [
      "Public",
      "{public}"
     ],
     [
      "File",
      "{filename}"
     ]
    ],
    "preview": "{content}"
   }
  },
  "create_or_update_file": {
   "action": "github.file.write",
   "risk": "high",
   "scope": {
    "owner": "{owner}",
    "repo": "{owner}/{repo}",
    "branch": "{owner}/{repo}/{branch}"
   },
   "summary": {
    "title": "Write {path} in {owner}/{repo}",
    "fields": [
     [
      "Branch",
      "{branch}"
     ],
     [
      "Commit message",
      "{message}"
     ]
    ],
    "preview": "{content}"
   }
  },
  "create_pull_request": {
   "action": "github.pr.create",
   "risk": "medium",
   "scope": {
    "owner": "{owner}",
    "repo": "{owner}/{repo}"
   },
   "summary": {
    "title": "Open a pull request in {owner}/{repo}",
    "fields": [
     [
      "Title",
      "{title}"
     ],
     [
      "From",
      "{head}"
     ],
     [
      "Into",
      "{base}"
     ],
     [
      "Draft",
      "{draft}"
     ]
    ],
    "preview": "{body}"
   }
  },
  "create_pull_request_with_copilot": {
   "action": "github.copilot.assign",
   "risk": "medium",
   "scope": {
    "owner": "{owner}",
    "repo": "{owner}/{repo}"
   },
   "summary": {
    "title": "Ask Copilot to open a pull request in {owner}/{repo}",
    "fields": [
     [
      "Title",
      "{title}"
     ]
    ],
    "preview": "{problem_statement}"
   }
  },
  "create_repository": {
   "action": "github.repo.create",
   "risk": "high",
   "summary": {
    "title": "Create repository {name}",
    "fields": [
     [
      "Private",
      "{private}"
     ],
     [
      "Organization",
      "{organization}"
     ]
    ],
    "preview": "{description}"
   }
  },
  "create_repository_ruleset": {
   "action": "github.repo.settings",
   "risk": "high",
   "scope": {
    "owner": "{owner}",
    "repo": "{owner}/{repo}"
   },
   "summary": {
    "title": "Create a ruleset in {owner}/{repo}",
    "fields": []
   }
  },
  "custom_properties_read": {
   "action": "github.read.custom_properties_read",
   "risk": "low"
  },
  "custom_properties_write": {
   "action": "github.repo.settings",
   "risk": "high",
   "scope": {
    "owner": "{owner}",
    "repo": "{owner}/{repo}"
   },
   "summary": {
    "title": "Change custom properties of {owner}/{repo}",
    "fields": []
   }
  },
  "delete_file": {
   "action": "github.file.delete",
   "risk": "high",
   "scope": {
    "owner": "{owner}",
    "repo": "{owner}/{repo}",
    "branch": "{owner}/{repo}/{branch}"
   },
   "summary": {
    "title": "Delete {path} in {owner}/{repo}",
    "fields": [
     [
      "Branch",
      "{branch}"
     ],
     [
      "Commit message",
      "{message}"
     ]
    ]
   }
  },
  "delete_repository": {
   "action": "github.repo.delete",
   "risk": "high",
   "scope": {
    "owner": "{owner}",
    "repo": "{owner}/{repo}"
   },
   "summary": {
    "title": "DELETE repository {owner}/{repo}",
    "fields": []
   }
  },
  "discussion_comment_write": {
   "action": "github.discussion.comment",
   "risk": "medium",
   "scope": {
    "owner": "{owner}",
    "repo": "{owner}/{repo}"
   },
   "summary": {
    "title": "{method} a discussion comment in {owner}/{repo}",
    "fields": [],
    "preview": "{body}"
   }
  },
  "dismiss_notification": {
   "action": "github.notification.update",
   "risk": "low"
  },
  "fork_repository": {
   "action": "github.repo.fork",
   "risk": "medium",
   "scope": {
    "owner": "{owner}",
    "repo": "{owner}/{repo}"
   },
   "summary": {
    "title": "Fork {owner}/{repo}",
    "fields": [
